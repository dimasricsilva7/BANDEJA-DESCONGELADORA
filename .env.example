# Banco de dados Postgres (Vercel Postgres / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# BravoPay (https://bravopay.club/docs)
BRAVOPAY_API_KEY="bp_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BRAVOPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BRAVOPAY_BASE_URL="https://bravopay.club/api/v1"
BRAVOPAY_PRODUCT_ID="cmxxxxxxxxxxxxxxxxxxxxxx"

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID="0000000000000000"
META_CONVERSIONS_API_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Conta de anuncios adicional (opcional) -- registra os mesmos eventos
# em uma segunda conta/pixel simultaneamente. Cada pixel precisa do seu
# proprio token de Conversions API (nao e compartilhavel entre contas).
# Pode repetir com _3, _4, _5 para mais contas.
# NEXT_PUBLIC_META_PIXEL_ID_2="0000000000000000"
# META_CONVERSIONS_API_TOKEN_2="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Autenticação admin
AUTH_SECRET="uma-string-aleatoria-com-pelo-menos-32-caracteres"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="troque-esta-senha"

# E-mail transacional (carrinho abandonado)
EMAIL_PROVIDER_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Loja <pedidos@seudominio.com>"

# URL pública do site (usada em CAPI, sitemap, schema.org)
NEXT_PUBLIC_SITE_URL="https://seu-dominio.vercel.app"
